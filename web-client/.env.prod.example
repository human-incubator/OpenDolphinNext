# Production 向け環境変数テンプレート
# MSW は無効化し、実 API へ接続する前提。
VITE_DISABLE_MSW=1

# Production の API ベース URL（同一オリジン前提）
# /api リバースプロキシの場合は相対パスを推奨
VITE_API_BASE_URL=/api

# サブパス配信（リバースプロキシ配下）の場合は両方を同じサブパスで指定する。
# 例: https://www.example.com/clinic/emr/
#   VITE_BASE_PATH=/clinic/emr
#   VITE_API_BASE_URL=/clinic/emr/api
# ルート相対の API パス（/api, /karte, /stamp, /patients, ...）は httpFetch / withBasePath が
# 実行時に VITE_BASE_PATH を前置する（重複前置はしない）。
# 本番ビルドでは VITE_ALLOW_MISSING_CSRF / VITE_ENABLE_MSW / VITE_ENABLE_FLAGGED_MOCKS を設定しないこと。

# 監査ログの送信先を分離する場合は指定（未使用ならコメントアウト）
# VITE_AUDIT_ENDPOINT=https://prod.example.com/audit

# HTTP タイムアウト（ミリ秒）
VITE_HTTP_TIMEOUT_MS=10000

# ネットワークエラー時の最大リトライ回数
VITE_HTTP_MAX_RETRIES=2

# ORCA マスター取得経路（現行の bridge 実装は base URL を参照）
WEB_ORCA_MASTER_SOURCE=server
VITE_ORCA_MASTER_BRIDGE=/api
VITE_ORCA_MASTER_BRIDGE_RUN_ID=20251124T073245Z
VITE_ORCA_MASTER_SNAPSHOT_VERSION=20251124T000000Z

# 観測系（任意）
# VITE_RUM_RUN_ID=20251228T000000Z
# VITE_PERF_LOG_ENDPOINT=https://prod.example.com/__perf-log
# X-Facility-Id を自動付与するか（本番は 0 を維持）。
VITE_ENABLE_FACILITY_HEADER=0
# デモ系 UI を表示するか（本番は 0 固定）。
VITE_ENABLE_DEMO_ENDPOINTS=0
# stub エンドポイントを表示/使用するか（本番は 0 固定）。
VITE_ENABLE_STUB_ENDPOINTS=0
